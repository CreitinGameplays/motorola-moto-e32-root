+#endif
+
+#if DIAG_PANIC_STAGE == 3
+#define DIAG_STAGE_3 panic("DIAG: stage 3 reached")
+#else
+#define DIAG_STAGE_3 do { } while (0)
+#endif
+
+#if DIAG_PANIC_STAGE == 4
