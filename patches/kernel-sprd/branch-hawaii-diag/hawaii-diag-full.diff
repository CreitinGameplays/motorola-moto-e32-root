+#else
+#define DIAG_STAGE_4 do { } while (0)
+#endif
+
+#if DIAG_PANIC_STAGE == 5
+#define DIAG_STAGE_5 panic("DIAG: stage 5 reached")
+#else
+#define DIAG_STAGE_5 do { } while (0)
+#endif
