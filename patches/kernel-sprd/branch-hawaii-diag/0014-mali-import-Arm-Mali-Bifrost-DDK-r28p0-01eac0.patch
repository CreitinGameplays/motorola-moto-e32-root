+		__entry->info_val = info_val;
+	),
+	TP_printk("kctx=%d_%u info=0x%llx", __entry->kctx_tgid,
+			__entry->kctx_id, __entry->info_val)
+);
+
+/* DEFINE_MALI_ADD_EVENT is available also to backends for backend-specific
+ * simple trace codes
+ */
