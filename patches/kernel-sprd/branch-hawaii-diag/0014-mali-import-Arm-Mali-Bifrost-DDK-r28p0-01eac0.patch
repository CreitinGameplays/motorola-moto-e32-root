index 000000000000..91a2d7ac4dcb
--- /dev/null
+++ b/drivers/gpu/arm/midgard/mmu/mali_kbase_mmu_mode_lpae.c
@@ -0,0 +1,215 @@
+/*
+ *
+ * (C) COPYRIGHT 2010-2019 ARM Limited. All rights reserved.
+ *
