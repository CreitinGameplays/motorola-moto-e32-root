diff --git a/drivers/gpu/arm/midgard/gpu/mali_kbase_gpu_id.h b/drivers/gpu/arm/midgard/gpu/mali_kbase_gpu_id.h
new file mode 100644
index 000000000000..446b83a5df11
--- /dev/null
+++ b/drivers/gpu/arm/midgard/gpu/mali_kbase_gpu_id.h
@@ -0,0 +1,118 @@
+/*
+ *
+ * (C) COPYRIGHT 2015-2020 ARM Limited. All rights reserved.
+ *
+ * This program is free software and is provided to you under the terms of the
+ * GNU General Public License version 2 as published by the Free Software
+ * Foundation, and any use by you of this program is subject to the terms
+ * of such GNU licence.
+ *
