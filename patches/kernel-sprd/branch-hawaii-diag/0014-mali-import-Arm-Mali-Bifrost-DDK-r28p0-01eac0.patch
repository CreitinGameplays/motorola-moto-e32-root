diff --git a/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_clk_rate_trace.c b/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_clk_rate_trace.c
new file mode 100644
index 000000000000..47933a739a58
--- /dev/null
+++ b/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_clk_rate_trace.c
@@ -0,0 +1,106 @@
+/*
+ *
+ * (C) COPYRIGHT 2015, 2017-2020 ARM Limited. All rights reserved.
+ *
