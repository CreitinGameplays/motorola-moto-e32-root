diff --git a/diag/prepare_stage_panics.py b/diag/prepare_stage_panics.py
new file mode 100755
index 000000000000..bda1d8fffbb7
--- /dev/null
+++ b/diag/prepare_stage_panics.py
@@ -0,0 +1,844 @@
+#!/usr/bin/env python3
+"""Prepare the staged instrumentation in init/main.c (idempotent).
+
+Two independent knobs, both in the generated include/linux/diag_stage.h, so a
+bisection step is one incremental rebuild of init/main.c (seconds), not a full
+kernel build:
+
+  DIAG_PANIC_STAGE  N   panic() at stage N.  Useful only for stages 8+ and for
+                        anything after do_basic_setup, because the PSCI restart
+                        handler is installed by an arch_initcall - before that
+                        a panic cannot reset the board and looks like a hang.
+  DIAG_ARM_STAGE    N   arm the AON watchdog (10 s, reset only, no FIQ) at
+                        stage N and keep booting.  N=9 arms at every stage
+                        from 2 upwards.  0 = off.
+  DIAG_SMC_STAGE    N   reset the SoC through PSCI SYSTEM_RESET (SMCCC
+                        0x84000009) at stage N.  Unlike the AON watchdog this
+                        needs no MMIO mapping and no clock, so it works from
+                        the first instruction of start_kernel(); it is a
+                        warm reset, so pstore survives it.  If the SMC is not
+                        implemented the call returns and the boot continues.
+                        0 = off.
+"""
+import pathlib
+import re
+import sys
+
+ROOT = pathlib.Path.home() / "kernel-sprd"
+
+HEADER = """#ifndef _LINUX_DIAG_STAGE_H
+#define _LINUX_DIAG_STAGE_H
+/*
+ * DIAG ONLY - not part of a real build.
+ * Generated by scripts/host/prepare_stage_panics.py, do not edit by hand.
+ *
+ *   1  first statement of start_kernel()   (proves the Image is executing)
+ *   2  after setup_arch()                  (DTB, memory map, paging, PSCI fw)
+ *   3  after build_all_zonelists/page_alloc
+ *   4  after check_bugs()
+ *   5  just before rest_init()
+ *   6  first statement of kernel_init()
+ *   7  after do_pre_smp_initcalls()
+ *   8  after do_basic_setup()              (every initcall, all drivers)
+ */
+
+#include <linux/io.h>
+#include <linux/bitops.h>
+#include <linux/arm-smccc.h>
+#include <linux/mm.h>
+#include <asm/cacheflush.h>
+#include <asm/barrier.h>
+#include <asm/cputype.h>
+#include <asm/early_ioremap.h>
+#include <asm/fixmap.h>
+#include <asm/virt.h>
+#define DIAG_SCREEN %SCREEN%
+
+/*
+ * Framebuffer text console.
+ *
+ * The bootloader leaves the panel scanning out lcd_base=0x9e000000, and that
+ * picture survives while a half-booted kernel hangs.  Geometry is measured,
+ * not assumed: the command line says lcd_size=1600x720 and logo_bpix=24, and
+ * /proc/device-tree/reserved-memory/logobuffer@9e000000 is 11.2 MB, so the
+ * buffer is packed RGB888 with a 4800-byte stride.  Writing 32-bit pixels
+ * there shears every glyph row by 4/3 (the "straight white lines" artefact).
+ *
+ * Row 0 is a permanent milestone line: each visual probe appends its band
+ * number, so one boot still says how far the kernel got even when it hangs
+ * before printing anything.  Rows below hold the printk mirror.
+ */
+#if DIAG_SCREEN
+#include <linux/diag_font.h>
+
+#define DIAG_FB_PHYS\t0x9e000000UL
+#define DIAG_FB_STRIDE\t4800UL\t/* 1600 * 3 bytes (logo_bpix=24) */
+#define DIAG_FB_ROWS\t720U
+#define DIAG_GLYPH_W\t8U
+#define DIAG_GLYPH_H\t16U
+#define DIAG_SCALE\t3U\t/* 24x48 glyphs */
+#define DIAG_CW\t(DIAG_GLYPH_W * DIAG_SCALE)
+#define DIAG_CH\t(DIAG_GLYPH_H * DIAG_SCALE)
+#define DIAG_TOP\t48U
+#define DIAG_COLS\t(DIAG_FB_STRIDE / 3UL / DIAG_CW)
+#define DIAG_ROWS\t((DIAG_FB_ROWS - DIAG_TOP) / DIAG_CH)
+#define DIAG_BG\t0x000000U
+
+/*
+ * The console state is ONE object with external linkage, not a set of
+ * file-scope statics.  This header is included by several translation units
+ * (setup.c, printk.c, init/main.c), and with statics each of them had its own
+ * diag_scr_ready - permanently false everywhere except setup.c.  That is why
+ * the stage tags compiled into init/main.c never appeared on the milestone
+ * line, and why the printk mirror in printk.c drew nothing.  setup.c defines
+ * the single instance.
+ */
+#define DIAG_HEAD\t4U\t/* row 0: milestones, rows 1..3: permanent info */
+
+struct diag_console {
+\tbool ready;
+\tunsigned int row;
+\tunsigned int trace_len;
+\tchar trace[DIAG_COLS + 1];
+\tunsigned int head_lines;
+\tchar head[DIAG_HEAD - 1][DIAG_COLS + 1];
+};
+
+extern struct diag_console diag_state;
+
+static inline u8 *diag_screen_row(unsigned int row)
+{
+	return (u8 *)phys_to_virt(DIAG_FB_PHYS +
+			(unsigned long)(DIAG_TOP + row * DIAG_CH) *
+			DIAG_FB_STRIDE);
+}
+
+static inline void diag_scr_pixel(u8 *p, u32 rgb)
+{
+	p[0] = (rgb >> 16) & 0xff;
+	p[1] = (rgb >> 8) & 0xff;
+	p[2] = rgb & 0xff;
+}
+
+static inline void diag_scr_glyph(u8 *base, unsigned char ch)
+{
+	const unsigned char *g = &diag_font_data[(unsigned int)ch * DIAG_GLYPH_H];
+	unsigned int y, x, i, j;
+
+	for (y = 0; y < DIAG_GLYPH_H; y++) {
+		u8 *line = base + (unsigned long)y * DIAG_SCALE * DIAG_FB_STRIDE;
+
+		for (x = 0; x < DIAG_GLYPH_W; x++) {
+			u32 rgb = (g[y] & (0x80U >> x)) ? 0xffffffU : DIAG_BG;
+
+			for (i = 0; i < DIAG_SCALE; i++)
+				for (j = 0; j < DIAG_SCALE; j++)
+					diag_scr_pixel(line +
+						(x * DIAG_SCALE + j) * 3U, rgb);
+		}
+	}
+}
+
+/* Draw one text row; the cursor does not move. */
+static inline void diag_screen_draw(unsigned int row, const char *text,
+				    unsigned int len)
+{
+	u8 *r = diag_screen_row(row);
+	unsigned int i;
+
+	for (i = 0; i < DIAG_COLS; i++) {
+		char c = (i < len && text[i] >= 0x20 && text[i] <= 0x7e) ?
+			 text[i] : ' ';
+
+		diag_scr_glyph(r + (unsigned long)i * DIAG_CW * 3U, c);
+	}
+	__flush_dcache_area(r, DIAG_CH * DIAG_FB_STRIDE);
+}
+
+static inline void diag_screen_clear(void)
+{
+	u8 *fb = diag_screen_row(0);
+	unsigned long y;
+	unsigned int i;
+
+	for (y = 0; y < (unsigned long)(DIAG_FB_ROWS - DIAG_TOP); y++)
+		memset(fb + y * DIAG_FB_STRIDE, 0, DIAG_FB_STRIDE);
+	__flush_dcache_area(fb, (unsigned long)(DIAG_FB_ROWS - DIAG_TOP) *
+			    DIAG_FB_STRIDE);
+	diag_state.row = DIAG_HEAD;
+	if (diag_state.trace_len)
+		diag_screen_draw(0, diag_state.trace, diag_state.trace_len);
+	for (i = 0; i < diag_state.head_lines; i++)
+		diag_screen_draw(i + 1, diag_state.head[i],
+				 strlen(diag_state.head[i]));
+}
+
+/*
+ * Permanent information rows (1..3).  They survive both scrolling and the
+ * clear() that scrolling performs, so a fact like "which EL did the kernel
+ * boot at" is still readable when the log is long.
+ */
+static inline void diag_screen_head(unsigned int n, const char *text,
+				    unsigned int len)
+{
+	unsigned int i;
+
+	if (n >= DIAG_HEAD - 1)
+		return;
+	if (len > DIAG_COLS)
+		len = DIAG_COLS;
+	for (i = 0; i < len; i++)
+		diag_state.head[n][i] =
+			(text[i] >= 0x20 && text[i] <= 0x7e) ? text[i] : ' ';
+	diag_state.head[n][len] = '\\0';
+	if (n + 1 > diag_state.head_lines)
+		diag_state.head_lines = n + 1;
+	diag_screen_draw(n + 1, diag_state.head[n], len);
+}
+
+static inline void diag_screen_puts(const char *text, size_t len)
+{
+	size_t i = 0;
+
+	if (!diag_state.ready || !text)
+		return;
+	while (i < len) {
+		unsigned int n = len - i;
+
+		if (n > DIAG_COLS)
+			n = DIAG_COLS;
+		if (diag_state.row >= DIAG_ROWS)
+			diag_screen_clear();
+		diag_screen_draw(diag_state.row, text + i, n);
+		diag_state.row++;
+		i += n;
+	}
+}
+
+/* Append a band number to the permanent milestone line. */
+static inline void diag_screen_tag(unsigned int n)
+{
+	if (!diag_state.ready)
+		return;
+	if (diag_state.trace_len >= 3 &&
+	    diag_state.trace[diag_state.trace_len - 3] == '0' + (n / 10) % 10 &&
+	    diag_state.trace[diag_state.trace_len - 2] == '0' + n % 10)
+		return;\t/* no consecutive duplicates */
+	if (diag_state.trace_len + 4 > DIAG_COLS)
+		return;
+	diag_state.trace[diag_state.trace_len++] = '0' + (n / 10) % 10;
+	diag_state.trace[diag_state.trace_len++] = '0' + n % 10;
+	diag_state.trace[diag_state.trace_len++] = ' ';
+	diag_state.trace[diag_state.trace_len] = '\\0';
+	diag_screen_draw(0, diag_state.trace, diag_state.trace_len);
+}
+
+/* Hex without printf: this runs long before any console driver exists. */
+static inline char *diag_hex(char *p, unsigned long long v, unsigned int digits)
+{
+	while (digits--) {
+		unsigned int d = (unsigned int)(v >> (digits * 4)) & 0xf;
+
+		*p++ = d < 10 ? '0' + d : 'a' + d - 10;
+	}
+	return p;
+}
+
+/*
+ * Which exception level did the bootloader enter the kernel at?
+ *
+ * It cannot be asked afterwards: el2_setup() drops to EL1 before any driver
+ * runs, and the "CPU: All CPU(s) started at ELx" line of a normal boot has
+ * long scrolled out of dmesg (pstore only keeps post-console messages).  KVM
+ * on arm64 needs the kernel to have been entered at EL2 (or to run VHE), so
+ * put the raw __boot_cpu_mode[] pair, the is_hyp_mode_available() verdict and
+ * ID_AA64PFR0_EL1 on the permanent rows while the console still works.
+ */
+static inline void diag_el_report(void)
+{
+	char line[DIAG_COLS + 1];
+	const char *verdict;
+	char *p;
+	u64 pfr0;
+
+	asm volatile("mrs %0, id_aa64pfr0_el1" : "=r" (pfr0));
+
+	memcpy(line, "EL bcm=", 7);
+	p = diag_hex(line + 7, __boot_cpu_mode[0], 8);
+	*p++ = '/';
+	p = diag_hex(p, __boot_cpu_mode[1], 8);
+	memcpy(p, " hyp=", 5);
+	p += 5;
+	*p++ = is_hyp_mode_available() ? '1' : '0';
+	*p = '\\0';
+	diag_screen_head(0, line, p - line);
+
+	memcpy(line, "PFR0=", 5);
+	p = diag_hex(line + 5, pfr0, 16);
+	memcpy(p, " MIDR=", 6);
+	p = diag_hex(p + 6, read_cpuid_id(), 8);
+	*p = '\\0';
+	diag_screen_head(1, line, p - line);
+
+	verdict = is_hyp_mode_available() ?
+		"EL2: KVM can work on this device" :
+		"no EL2 -> KVM impossible here";
+	diag_screen_head(2, verdict, strlen(verdict));
+
+	diag_state.row = DIAG_HEAD;
+}
+
+#define DIAG_TAG(n) diag_screen_tag(n)
+
+/*
+ * Post-setup_arch stages report on the milestone line only: the paint
+ * bands stop at 19, and a tag cannot collide with a band number.
+ */
+#define DIAG_STAGE_TAG(n) \\
+\tdo { if (DIAG_PAINT) DIAG_TAG(n); } while (0)
+
+static inline void diag_screen_init(void)
+{
+	diag_state.ready = true;
+	diag_screen_clear();
+	diag_screen_tag(15);\t/* paging_init() just returned */
+}
+#else
+static inline void diag_screen_init(void) { }
+#define DIAG_TAG(n) do { } while (0)
+#define DIAG_EL_REPORT do { } while (0)
+#define DIAG_SCR_READY 0
+#endif
+
+#define DIAG_SCREEN_INIT diag_screen_init()
+#define DIAG_EL_REPORT diag_el_report()
+#define DIAG_SCR_READY diag_state.ready
+
+/*
+ * printk mirror entry point, defined exactly once, in
+ * arch/arm64/kernel/setup.c, next to the console itself.  The state is a
+ * single global now, but keeping one entry point means the mirror cannot
+ * drift from the console (and is the place a lock would go if printk from
+ * several CPUs ever races here).
+ */
+void diag_stage_mirror(const char *text, size_t len);
+
+
+#define DIAG_PANIC_STAGE %PANIC%
+#define DIAG_ARM_STAGE %ARM%
+#define DIAG_ARM_TIMEOUT 10
+#define DIAG_SMC_STAGE %SMC%
+
+/*
+ * Reset the SoC through the PSCI SYSTEM_RESET function (SMCCC 0x84000009).
+ *
+ * This is the only reset source usable at the very first statement of
+ * start_kernel(): it is a secure-monitor call, so it needs no device mapping,
+ * no clock and no driver.  It is also a warm reset, which is what makes the
+ * ramoops/pstore region survive and be readable on the next boot.
+ *
+ * If the monitor does not implement the function the call simply returns and
+ * the boot continues, so "no reset" must be read as "the code did not run"
+ * only after a stage that is known to be reached.
+ */
+static inline void diag_psci_reset(void)
+{
+\tstruct arm_smccc_res res;
+
+\tarm_smccc_smc(0x84000009UL, 0, 0, 0, 0, 0, 0, 0, &res);
+}
+
+#define DIAG_SMC_HOOK(n) \\
+\tdo { if (DIAG_SMC_STAGE == (n)) diag_psci_reset(); } while (0)
+
+#define DIAG_PAINT %PAINT%
+
+/*
+ * Visual stage trace: paint white bands at the bootloader's framebuffer.
+ *
+ * The bootloader leaves the panel scanning out of lcd_base=0x9e000000, and
+ * that picture stays up while a half-booted kernel hangs (the operator sees
+ * the Motorola logo).  Filling horizontal bands there therefore gives a
+ * progress bar that needs no reset, no ramoops and no console.
+ *
+ * Layout: band n occupies bytes [n*DIAG_PAINT_BAND, (n+1)*DIAG_PAINT_BAND) of
+ * physical 0x9e000000, so the bands stack downwards and their number is the
+ * answer.  10 bands are 1.28 MB, comfortably inside the 1600x720x32 panel
+ * buffer and below the next reserved region at 0x9f000000.
+ *
+ * band 0 is painted by the entry stub (scripts/host/entry_paint.py, MMU off,
+ * before head.S).  DIAG_PAINT=1 paints start_kernel()'s stages 2..8 into
+ * bands 1..7; DIAG_PAINT=2 paints the setup_arch() milestones below into
+ * bands 1..9.  Two paint paths, because the linear mapping is only complete
+ * after paging_init():
+ *   diag_paint_early()  early_ioremap(), usable from early_ioremap_init()
+ *                       until early_ioremap_reset() inside setup_arch();
+ *   diag_paint()        phys_to_virt(), valid once paging_init() has mapped
+ *                       the reserved-memory node (it has no `no-map`).
+ */
+#define DIAG_PAINT_BASE 0x9e000000UL
+#define DIAG_PAINT_BAND 0x20000UL\t/* 131072 bytes = 128 KB */
+
+static inline void diag_paint(unsigned int band)
+{
+\tvolatile u64 *p = (volatile u64 *)phys_to_virt(DIAG_PAINT_BASE +
+\t\t\t\t\t      band * DIAG_PAINT_BAND);
+\tunsigned int i;
+
+\t/*
+\t * Once the text console is up the band would only overwrite the log it
+\t * is pointing at, so keep the milestone tag and skip the fill.
+\t */
+\tif (!DIAG_SCR_READY) {
+\t\tfor (i = 0; i < DIAG_PAINT_BAND / sizeof(u64); i++)
+\t\t\tp[i] = ~0ULL;
+\t\tdsb(sy);
+\t}
+\tDIAG_TAG(band);
+}
+
+static inline void diag_paint_early(unsigned int band)
+{
+\tvoid __iomem *p = early_ioremap(DIAG_PAINT_BASE + band * DIAG_PAINT_BAND,
+\t\t\t\t\tDIAG_PAINT_BAND);
+
+\tif (!p)
+\t\treturn;
+\tmemset_io(p, 0xff, DIAG_PAINT_BAND);
+\tearly_iounmap(p, DIAG_PAINT_BAND);
+\tdsb(sy);
+\tDIAG_TAG(band);
+}
+
+/* start_kernel() stages (mode 1) */
+#define DIAG_PAINT_HOOK(n) \\
+\tdo { if (DIAG_PAINT == 1) diag_paint((n) - 1); } while (0)
+
+/* setup_arch() milestones (mode 2); e = 1 for the early_ioremap path */
+#define DIAG_TRACE_HOOK(n, e) \\
+\tdo { if (DIAG_PAINT == 2) { \\
+\t\tif (e) { diag_paint_early(n); } else { diag_paint(n); } \\
+\t} } while (0)
+
+/*
+ * Pre-arch paint: start_kernel() and the first statements of setup_arch()
+ * run before paging_init() has mapped RAM, so diag_paint() cannot be used.
+ * The fixmap, however, can map any physical page very early, so we set it up
+ * ourselves and paint through early_ioremap().  Both helpers are idempotent
+ * and setup_arch() calls them again a few lines later.
+ */
+static bool diag_prearch_ready;
+
+static inline void diag_paint_prearch(unsigned int band)
+{
+\tif (!diag_prearch_ready) {
+\t\tearly_fixmap_init();
+\t\tearly_ioremap_init();
+\t\tdiag_prearch_ready = true;
+\t}
+\tdiag_paint_early(band);
+}
+
+#define DIAG_EARLY_HOOK(n) \\
+\tdo { if (DIAG_PAINT == 2) diag_paint_prearch(n); } while (0)
+
+
+/*
+ * Arm the SoC's AON watchdog directly.  This is deliberately independent of
+ * the driver: drivers/watchdog/sprd_wdt_fiq.c registers with
+ * module_platform_driver(), i.e. a device_initcall, which is far too late to
+ * cover a stall in start_kernel()/setup_arch().  The register sequence is
+ * copied from sprd_wdt_fiq_{unlock,load_value,enable,start}(); interrupts are
+ * left off (INT_EN clear) so a timeout is a plain SoC reset, no FIQ needed.
+ *
+ * 0x644e0000 = /soc/aon/watchdog@644e0000 (sprd,wdt-r2p0-fiq).
+ */
+static inline void diag_arm_aon_wdt(void)
+{
+\tvoid __iomem *base = ioremap(0x644e0000, 0x1000);
+\tu32 step = DIAG_ARM_TIMEOUT * 32768U;
+\tint i;
+
+\tif (!base)
+\t\treturn;
+
+\twritel_relaxed(0xe551, base + 0x20);       /* LOCK: unlock key */
+\twritel_relaxed((step >> 16) & 0xffff, base + 0x04); /* LOAD_HIGH */
+\twritel_relaxed(step & 0xffff, base + 0x00);         /* LOAD_LOW */
+\twritel_relaxed(0, base + 0x30);            /* IRQ_LOAD_HIGH */
+\twritel_relaxed(0, base + 0x2c);            /* IRQ_LOAD_LOW */
+\twritel_relaxed(0, base + 0x20);            /* LOCK: lock again */
+
+\t/* wait for LD_BUSY to clear, as the driver does */
+\tfor (i = 0; i < 1000; i++) {
+\t\tif (!(readl_relaxed(base + 0x10) & BIT(4)))
+\t\t\tbreak;
+\t\tcpu_relax();
+\t}
+
+\t/* CTRL: NEW_VER_EN, then CNT_EN | RST_EN (no INT_EN) */
+\twritel_relaxed(readl_relaxed(base + 0x08) | BIT(2), base + 0x08);
+\twritel_relaxed(readl_relaxed(base + 0x08) | BIT(1) | BIT(3), base + 0x08);
+}
+
+#define DIAG_ARM_HOOK(n) \\
+\tdo { if (DIAG_ARM_STAGE == (n) || DIAG_ARM_STAGE == 9) diag_arm_aon_wdt(); } while (0)
+"""
+
+for n in range(1, 9):
+    HEADER += """
+#if DIAG_PANIC_STAGE == %d
+#define DIAG_STAGE_%d panic("DIAG: stage %d reached")
+#else
+#define DIAG_STAGE_%d do { } while (0)
+#endif
+""" % (n, n, n, n)
+
+HEADER += "\n#endif /* _LINUX_DIAG_STAGE_H */\n"
+
+EDITS = [
+    ("asmlinkage __visible void __init start_kernel(void)\n{\n\tchar *command_line;\n\tchar *after_dashes;\n",
+     "\tDIAG_STAGE_1;\n", "DIAG_STAGE_1;"),
+    ("\tpr_notice(\"%s\", linux_banner);\n\tsetup_arch(&command_line);\n",
+     "\tDIAG_STAGE_2;\n\tDIAG_ARM_HOOK(2);\n", "DIAG_ARM_HOOK(2);"),
+    ("\tbuild_all_zonelists(NULL);\n\tpage_alloc_init();\n",
+     "\tDIAG_STAGE_3;\n\tDIAG_ARM_HOOK(3);\n", "DIAG_ARM_HOOK(3);"),
+    ("\tcheck_bugs();\n",
+     "\tDIAG_STAGE_4;\n\tDIAG_ARM_HOOK(4);\n", "DIAG_ARM_HOOK(4);"),
+    ("\t/* Do the rest non-__init'ed, we're now alive */\n\trest_init();\n",
+     "\tDIAG_STAGE_5;\n\tDIAG_ARM_HOOK(5);\n", "DIAG_ARM_HOOK(5);"),
+    ("static int __ref kernel_init(void *unused)\n{\n\tint ret;\n\n\tkernel_init_freeable();\n",
+     "\tDIAG_STAGE_6;\n\tDIAG_ARM_HOOK(6);\n", "DIAG_ARM_HOOK(6);"),
+    ("\tdo_pre_smp_initcalls();\n\tlockup_detector_init();\n",
+     "\tDIAG_STAGE_7;\n\tDIAG_ARM_HOOK(7);\n", "DIAG_ARM_HOOK(7);"),
+    ("\tdo_basic_setup();\n",
+     "\tDIAG_STAGE_8;\n\tDIAG_ARM_HOOK(8);\n", "DIAG_ARM_HOOK(8);"),
+]
+
+# setup_arch() milestones for paint mode 2, in execution order.  Bands 1..4
+# use early_ioremap() (before paging_init()), bands 5..9 phys_to_virt().
+# setup_arch() milestones for paint mode 2, in execution order.  Bands 11..14
+# use early_ioremap() (before paging_init()), bands 15..19 phys_to_virt().
+SETUP_TRACE = [
+    ("\tearly_ioremap_init();\n", "\tDIAG_TRACE_HOOK(11, 1);\n"),
+    ("\tsetup_machine_fdt(__fdt_pointer);\n", "\tDIAG_TRACE_HOOK(12, 1);\n"),
+    ("\tparse_early_param();\n", "\tDIAG_TRACE_HOOK(13, 1);\n"),
+    ("\tarm64_memblock_init();\n", "\tDIAG_TRACE_HOOK(14, 1);\n"),
+    ("\tpaging_init();\n", "\tDIAG_TRACE_HOOK(15, 0);\n"),
+    ("\t\tunflatten_device_tree();\n", "\t\tDIAG_TRACE_HOOK(16, 0);\n"),
+    ("\trequest_standard_resources();\n", "\tDIAG_TRACE_HOOK(17, 0);\n"),
+    ("\tsmp_init_cpus();\n", "\tDIAG_TRACE_HOOK(18, 0);\n"),
+    ("\tsmp_build_mpidr_hash();\n", "\tDIAG_TRACE_HOOK(19, 0);\n"),
+]
+
+# start_kernel()'s statements before setup_arch(), paint mode 2 bands 1..9.
+# These run before paging_init(), so they go through the fixmap.
+EARLY_TRACE = [
+    ("\tDIAG_STAGE_1;\n", 1),
+    ("\tset_task_stack_end_magic(&init_task);\n", 2),
+    ("\tsmp_setup_processor_id();\n", 3),
+    ("\tdebug_objects_early_init();\n", 4),
+    ("\tcgroup_init_early();\n", 5),
+    ("\tearly_boot_irqs_disabled = true;\n", 6),
+    ("\tboot_cpu_init();\n", 7),
+    ("\tpage_address_init();\n", 8),
+    ("\tpr_notice(\"%s\", linux_banner);\n", 9),
+]
+
+
+def write_font_header(root):
+    """Extract the in-tree 8x16 VGA font into a small standalone header.
+
+    CONFIG_FONT_8x16 is off in this build, but lib/fonts/font_8x16.c ships the
+    data regardless; parsing it avoids enabling the whole font framework just
+    to draw a few hundred characters.
+    """
+    import re
+    src = (root / "lib" / "fonts" / "font_8x16.c").read_bytes().decode("latin-1")
+    start = src.index("fontdata_8x16[FONTDATAMAX]")
+    body = src[src.index("{", start):]
+    # strip comments first: the per-byte comments contain text like
+    # "/* 125 0x7d '}' */" which both looks like hex data and closes the body
+    # early if we cut at the first '}'.
+    body = re.sub(r"/\*.*?\*/", "", body, flags=re.S)
+    vals = [int(v, 16) for v in re.findall(r"0x([0-9a-fA-F]{2})", body)]
+    if len(vals) < 4096:
+        raise SystemExit("font parse produced %d bytes" % len(vals))
+    vals = vals[:4096]
+    out = ['#ifndef _LINUX_DIAG_FONT_H', '#define _LINUX_DIAG_FONT_H', '',
+           '/* 8x16 VGA font, extracted from lib/fonts/font_8x16.c. */',
+           'static const unsigned char diag_font_data[4096] __maybe_unused = {']
+    for i in range(0, 4096, 16):
+        out.append('\t' + ' '.join('0x%02x,' % b for b in vals[i:i + 16]))
+    out += ['};', '', '#endif']
+    (root / "include" / "linux" / "diag_font.h").write_text('\n'.join(out) + '\n')
+    print("wrote include/linux/diag_font.h (4096 font bytes)")
+
+
+def main():
+    panic_stage = sys.argv[1] if len(sys.argv) > 1 else "0"
+    arm_stage = sys.argv[2] if len(sys.argv) > 2 else "0"
+    smc_stage = sys.argv[3] if len(sys.argv) > 3 else "0"
+    paint = sys.argv[4] if len(sys.argv) > 4 else "0"
+    screen = sys.argv[5] if len(sys.argv) > 5 else "0"
+    src = ROOT / "init" / "main.c"
+    hdr = ROOT / "include" / "linux" / "diag_stage.h"
+
+    if screen != "0":
+        write_font_header(ROOT)
+
+    hdr.write_text(HEADER.replace("%PANIC%", panic_stage)
+                         .replace("%ARM%", arm_stage)
+                         .replace("%SMC%", smc_stage)
+                         .replace("%PAINT%", paint)
+                         .replace("%SCREEN%", screen))
+    print("wrote include/linux/diag_stage.h (panic=%s arm=%s smc=%s paint=%s screen=%s)"
+          % (panic_stage, arm_stage, smc_stage, paint, screen))
+
+    s = src.read_text()
+
+    if "diag_stage.h" not in s:
+        anchor = "asmlinkage __visible void __init start_kernel(void)"
+        assert s.count(anchor) == 1
+        s = s.replace(anchor, '#include <linux/diag_stage.h>\n\n' + anchor)
+        print("added #include <linux/diag_stage.h>")
+
+    for anchor, ins, marker in EDITS:
+        if marker in s:
+            continue
+        n = s.count(anchor)
+        if n != 1:
+            print("WARN: anchor for %s occurs %d times, skipped" % (marker, n))
+            continue
+        s = s.replace(anchor, anchor + ins)
+        print("inserted %s" % marker)
+
+    # The SMC hooks go in separately: main.c already carries the arm hooks
+    # from earlier builds, so the EDITS loop above would skip these anchors.
+    for n in range(1, 9):
+        marker = "DIAG_SMC_HOOK(%d);" % n
+        if marker in s:
+            continue
+        arm = "DIAG_ARM_HOOK(%d);" % n
+        if n == 1 and "\tDIAG_STAGE_1;\n" in s:
+            anchor = "\tDIAG_STAGE_1;\n"
+        elif arm in s:
+            anchor = "\t" + arm + "\n"
+        else:
+            print("WARN: no anchor for %s" % marker)
+            continue
+        s = s.replace(anchor, anchor + "\t" + marker + "\n", 1)
+        print("inserted %s" % marker)
+
+    # Same for the paint hooks (stages 2..8: stage 1 runs before setup_arch()
+    # has installed the linear mapping that 0x9e000000 needs).
+    for n in range(2, 9):
+        marker = "DIAG_PAINT_HOOK(%d);" % n
+        if marker in s:
+            continue
+        smc = "DIAG_SMC_HOOK(%d);" % n
+        if smc not in s:
+            print("WARN: no smc hook as anchor for %s" % marker)
+            continue
+        anchor = "\t" + smc + "\n"
+        s = s.replace(anchor, anchor + "\t" + marker + "\n", 1)
+        print("inserted %s" % marker)
+
+    # Report-only tags for the same stages, so the milestone line covers
+    # everything after setup_arch() too (paint bands stop at 19).
+    for n in range(2, 9):
+        tag = "DIAG_STAGE_TAG(%d);" % (20 + n)
+        if tag in s:
+            continue
+        for cand in ("\tDIAG_PAINT_HOOK(%d);\n" % n,
+                     "\tDIAG_SMC_HOOK(%d);\n" % n):
+            if cand in s:
+                s = s.replace(cand, cand + "\t" + tag + "\n", 1)
+                print("inserted %s" % tag)
+                break
+        else:
+            print("WARN: no anchor for %s" % tag)
+
+    # start_kernel()'s statements before setup_arch() (paint mode 2, bands 1..9)
+    for anchor, band in EARLY_TRACE:
+        hook = "\tDIAG_EARLY_HOOK(%d);\n" % band
+        if hook.strip() in s:
+            continue
+        if s.count(anchor) != 1:
+            print("WARN: early anchor occurs %d times: %r"
+                  % (s.count(anchor), anchor))
+            continue
+        s = s.replace(anchor, anchor + hook, 1)
+        print("inserted %s" % hook.strip())
+
+    # setup_arch() band 15: the linear mapping now exists, so the on-screen
+    # console can start mirroring printk from here on.
+    # printk mirrors to the screen (kernel/printk/printk.c)
+    pk = ROOT / "kernel" / "printk" / "printk.c"
+    p = pk.read_text()
+    if screen != "0":
+        if "#include <linux/diag_stage.h>" not in p:
+            i = p.index("#include <linux/")
+            p = p[:i] + "#include <linux/diag_stage.h>\n" + p[i:]
+            print("added diag include to printk.c")
+        hook = ("\t#if DIAG_SCREEN\n\tdiag_stage_mirror(text, text_len);\n\t#endif\n")
+        if "diag_stage_mirror(text, text_len);" not in p:
+            # drop a hook from an older generator (it drew into its own,
+            # never-initialised copy of the console state)
+            p = re.sub(r"[ \t]*#if DIAG_SCREEN\n[ \t]*diag_screen_puts\(text, text_len\);\n[ \t]*#endif\n", "", p)
+            anchor = "\treturn log_output(facility, level, lflags,\n"
+            if p.count(anchor) == 1:
+                p = p.replace(anchor, hook + anchor, 1)
+                print("inserted printk->screen hook")
+            else:
+                print("WARN: printk log_output anchor not unique")
+    else:
+        p = p.replace("#include <linux/diag_stage.h>\n", "")
+        p = re.sub(r"[ \t]*#if DIAG_SCREEN\n[ \t]*diag_(stage_mirror|screen_puts)\(text, text_len\);\n[ \t]*#endif\n", "", p)
+    pk.write_text(p)
+
+    # One report per boot for an invalid notifier, instead of a WARN per idle
+    # entry.  CONFIG_DEBUG_NOTIFIERS (also set in the shipping config) rejects
+    # callbacks that are not in core kernel text; something on the CPU_PM chain
+    # is outside it, so the stock WARN fires at every cpuidle exit and buries
+    # the real log tail under an identical backtrace.
+    nf = ROOT / "kernel" / "notifier.c"
+    n = nf.read_text()
+    decl = "static bool diag_bad_notifier_reported;\n"
+    if decl not in n:
+        anchor = "static int notifier_call_chain(struct notifier_block **nl,\n"
+        if n.count(anchor) == 1:
+            n = n.replace(anchor,
+                          "#include <linux/printk.h>\n" + decl + "\n" + anchor, 1)
+            print("added diag_bad_notifier_reported to notifier.c")
+        else:
+            print("WARN: notifier.c has no notifier_call_chain anchor")
+    if "diag: invalid notifier" not in n:
+        warn = ("#ifdef CONFIG_DEBUG_NOTIFIERS\n"
+                "\t\tif (unlikely(!func_ptr_is_kernel_text(nb->notifier_call))) {\n"
+                "\t\t\tWARN(1, \"Invalid notifier called!\");\n"
+                "\t\t\tnb = next_nb;\n"
+                "\t\t\tcontinue;\n"
+                "\t\t}\n"
+                "#endif\n")
+        repl = ("#ifdef CONFIG_DEBUG_NOTIFIERS\n"
+                "\t\tif (unlikely(!func_ptr_is_kernel_text(nb->notifier_call))) {\n"
+                "\t\t\t/*\n"
+                "\t\t\t * DIAG: report once, naming the block and its callback,\n"
+                "\t\t\t * then keep skipping it.  On this device this is the\n"
+                "\t\t\t * CPU_PM chain, so the stock WARN fires at every\n"
+                "\t\t\t * cpuidle exit and buries the log tail.\n"
+                "\t\t\t */\n"
+                "\t\t\tif (!diag_bad_notifier_reported) {\n"
+                "\t\t\t\tdiag_bad_notifier_reported = true;\n"
+                "\t\t\t\tpr_err(\"diag: invalid notifier %px callback=%pS (skipped)\\n\",\n"
+                "\t\t\t\t       nb, nb->notifier_call);\n"
+                "\t\t\t}\n"
+                "\t\t\tnb = next_nb;\n"
+                "\t\t\tcontinue;\n"
+                "\t\t}\n"
+                "#endif\n")
+        if n.count(warn) != 1:
+            print("WARN: notifier.c anchor found %d times" % n.count(warn))
+        else:
+            n = n.replace(warn, repl, 1)
+            print("patched notifier.c: one-time invalid-notifier report")
+    nf.write_text(n)
+
+    # setup_arch() trace (paint mode 2): milestones inside
+    # arch/arm64/kernel/setup.c, bands 1..9.  The first ones must use
+    # early_ioremap() because the linear mapping of 0x9e000000 only appears
+    # with paging_init(); the later ones use phys_to_virt().
+    setup = ROOT / "arch" / "arm64" / "kernel" / "setup.c"
+    t = setup.read_text()
+    # Drop any trace hooks from an earlier run so the band numbering is never
+    # a mix of two generations (they are re-inserted below under the current
+    # numbering).
+    stripped = re.sub(r"[ \t]*DIAG_TRACE_HOOK\([0-9]+, [01]\);\n", "", t)
+    if stripped != t:
+        print("removed stale DIAG_TRACE_HOOK lines from setup.c")
+        t = stripped
+    if "diag_stage.h" not in t:
+        inc = "#include <linux/init.h>\n"
+        if t.count(inc) == 1:
+            t = t.replace(inc, inc + "#include <linux/diag_stage.h>\n", 1)
+            print("added #include <linux/diag_stage.h> to setup.c")
+        else:
+            print("WARN: include anchor missing in setup.c")
+    # The printk mirror must land in this file's copy of the console state;
+    # see the long comment on diag_stage_mirror() in the header.
+    old_mirror = (
+        "#if DIAG_SCREEN\n"
+        "/* the one copy of the panel console that printk mirrors into */\n"
+        "void diag_stage_mirror(const char *text, size_t len)\n"
+        "{\n"
+        "\tdiag_screen_puts(text, len);\n"
+        "}\n"
+        "#endif\n")
+    if old_mirror in t:
+        # a previous run inserted the wrapper without the shared instance
+        t = t.replace(old_mirror, "", 1)
+    mirror_def = (
+        "#if DIAG_SCREEN\n"
+        "/* the single console instance shared by every translation unit */\n"
+        "struct diag_console diag_state;\n"
+        "\n"
+        "void diag_stage_mirror(const char *text, size_t len)\n"
+        "{\n"
+        "\tdiag_screen_puts(text, len);\n"
+        "}\n"
+        "#endif\n")
+    if "void diag_stage_mirror" not in t:
+        inc = "#include <linux/diag_stage.h>\n"
+        if t.count(inc) == 1:
+            t = t.replace(inc, inc + "\n" + mirror_def, 1)
+            print("added diag_stage_mirror() to setup.c")
+        else:
+            print("WARN: no diag include anchor for diag_stage_mirror()")
+    for anchor, hook in SETUP_TRACE:
+        if hook.strip() in t:
+            continue
+        if t.count(anchor) != 1:
+            print("WARN: anchor occurs %d times in setup.c: %r"
+                  % (t.count(anchor), anchor))
+            continue
+        t = t.replace(anchor, anchor + hook, 1)
+        print("inserted %s in setup.c" % hook.strip())
+    # band 10: the first statement of setup_arch() itself
+    entry = "void __init setup_arch(char **cmdline_p)\n{\n"
+    hook10 = "\tDIAG_EARLY_HOOK(10);\n"
+    if hook10.strip() not in t and t.count(entry) == 1:
+        t = t.replace(entry, entry + hook10, 1)
+        print("inserted %s in setup.c" % hook10.strip())
+    # the on-screen console can start once the linear map exists
+    screen_init = "\tDIAG_SCREEN_INIT;\n"
+    el_report = ("\t/* KVM needs the kernel to have been entered at EL2: record\n"
+                 "\t * what the bootloader actually handed over, while we can\n"
+                 "\t * still draw text on the panel.\n"
+                 "\t */\n"
+                 "\tDIAG_EL_REPORT;\n")
+    paging = "\tpaging_init();\n"
+    if screen_init.strip() not in t and t.count(paging) == 1:
+        t = t.replace(paging, paging + screen_init, 1)
+        print("inserted %s in setup.c" % screen_init.strip())
+    if el_report.strip() not in t:
+        if screen_init in t:
+            t = t.replace(screen_init, screen_init + el_report, 1)
+            print("inserted DIAG_EL_REPORT in setup.c")
+        else:
+            print("WARN: no DIAG_SCREEN_INIT anchor for DIAG_EL_REPORT")
+    setup.write_text(t)
+
+    # the end-of-init panic must not mask any instrument
+    old = "#if defined(DIAG_PANIC_AFTER_INIT) && DIAG_PANIC_STAGE == 0"
+    new = ("#if defined(DIAG_PANIC_AFTER_INIT) && DIAG_PANIC_STAGE == 0 && "
+           "DIAG_ARM_STAGE == 0 && DIAG_SMC_STAGE == 0 && DIAG_PAINT == 0")
+    if old in s and new not in s:
+        s = s.replace(old, new)
+        print("made DIAG_PANIC_AFTER_INIT yield to staged panics and to the arm")
+
+    src.write_text(s)
+
+
+if __name__ == "__main__":
+    main()
