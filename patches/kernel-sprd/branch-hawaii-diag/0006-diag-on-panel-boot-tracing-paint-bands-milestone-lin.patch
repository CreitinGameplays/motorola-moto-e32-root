diff --git a/virt/kvm/arm/arm.c b/virt/kvm/arm/arm.c
index 09ef6260477e..a0c31e383828 100644
--- a/virt/kvm/arm/arm.c
+++ b/virt/kvm/arm/arm.c
@@ -1522,4 +1522,10 @@ static int arm_init(void)
 	return rc;
 }
 
+#ifdef DIAG_KVM_LATE_INIT
