# Normalize line endings: LF in the repository for everything, CRLF for
# Windows-only script types so they still run from a checkout on Windows.
* text=auto eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary/build products (only relevant if they are ever tracked)
*.bin binary
*.elf binary
*.img binary
*.apk binary
*.zip binary
